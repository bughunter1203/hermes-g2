{
  "package_id": "ai.crewnova.hermesg2",
  "edition": "202601",
  "name": "Hermes G2",
  "version": "0.3.1",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.10",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Connect to the Hermes bridge",
      "whitelist": [
        "wss://g2.example.com",
        "https://g2.example.com",
        "wss://your-node.your-tailnet.ts.net:8443",
        "https://your-node.your-tailnet.ts.net:8443"
      ]
    },
    { "name": "g2-microphone", "desc": "Voice input for Hermes agent" }
  ],
  "supported_languages": [
    "en"
  ]
}
